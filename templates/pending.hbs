{{!-- Pending characters (PLAN 4.2): builds waiting for a GM, builds the validator refused, and every character in
     progress, which the GM can clear. --}}
<div class="cc-pending__body">
  <header class="cc-pending__head">
    <div>
      <h2>{{localize "CHARCREATOR.Pending.Heading"}}</h2>
      <p class="cc-hint">
        {{#if empty}}{{localize "CHARCREATOR.Pending.Nothing"}}
        {{else}}{{localize "CHARCREATOR.Pending.Waiting"}} {{counts.waiting}} ·
        {{localize "CHARCREATOR.Pending.Refused"}} {{counts.failed}}
        {{/if}}
      </p>
    </div>
    {{#if counts.waiting}}
    <button type="button" class="cc-button cc-button--primary" data-action="all" {{#if busy}}disabled{{/if}}>
      {{localize "CHARCREATOR.Pending.CreateAll"}}
    </button>
    {{/if}}
  </header>

  <div class="cc-pending__scroll">
  <ul class="cc-queue">
    {{#each rows as |r|}}
    <li class="cc-queue__row cc-queue__row--{{r.kind}}">
      <div class="cc-queue__who">
        <span class="cc-queue__player">{{r.player}}</span>
        <span class="cc-queue__character">{{#if r.character}}{{r.character}}{{else}}{{localize "CHARCREATOR.Pending.Unnamed"}}{{/if}}</span>
        {{#if r.picksText}}<span class="cc-queue__picks">{{r.picksText}}</span>{{/if}}
      </div>

      <div class="cc-queue__state">
        {{#if (eq r.kind "waiting")}}
        <span class="cc-queue__badge cc-queue__badge--waiting">{{localize "CHARCREATOR.Pending.BadgeWaiting"}}</span>
        {{#if r.hasPortrait}}<span class="cc-queue__note">{{localize "CHARCREATOR.Pending.WithPortrait"}}</span>{{/if}}
        {{else}}
        <span class="cc-queue__badge cc-queue__badge--failed">{{localize "CHARCREATOR.Pending.BadgeRefused"}}</span>
        <ul class="cc-problems">
          {{#each r.errors as |e|}}
          <li class="cc-problem">{{e.message}}{{#if e.stepLabel}} <span class="cc-queue__step">({{e.stepLabel}})</span>{{/if}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>

      <div class="cc-queue__actions">
        {{#if r.canCreate}}
        <button type="button" class="cc-button cc-button--primary" data-action="create" data-user="{{r.userId}}"
                {{#if ../busy}}disabled{{/if}}>
          {{#if r.busy}}{{localize "CHARCREATOR.Pending.Creating"}}{{else}}{{localize "CHARCREATOR.Pending.CreateNow"}}{{/if}}
        </button>
        {{/if}}
        {{#if r.canRetry}}
        <button type="button" class="cc-button" data-action="retry" data-user="{{r.userId}}"
                {{#if ../busy}}disabled{{/if}}>
          {{localize "CHARCREATOR.Pending.TryAgain"}}
        </button>
        {{/if}}
      </div>
    </li>
    {{/each}}

    {{#if empty}}
    <li class="cc-empty">{{localize "CHARCREATOR.Pending.NothingHint"}}</li>
    {{/if}}
  </ul>

  <section class="cc-drafts">
    <header class="cc-drafts__head">
      <div>
        <h3>{{localize "CHARCREATOR.Pending.InProgress"}}</h3>
        <p class="cc-hint">{{localize "CHARCREATOR.Pending.InProgressHint"}}</p>
      </div>
      {{#if drafts.length}}
      <button type="button" class="cc-button" data-action="clearAll" {{#if busy}}disabled{{/if}}>
        {{localize "CHARCREATOR.Pending.ClearAll"}}
      </button>
      {{/if}}
    </header>
    <ul class="cc-queue cc-queue--drafts">
      {{#each drafts as |d|}}
      <li class="cc-queue__row cc-queue__row--draft">
        <div class="cc-queue__who">
          <span class="cc-queue__player">{{d.player}}</span>
          <span class="cc-queue__character">{{#if d.character}}{{d.character}}{{else}}{{localize "CHARCREATOR.Pending.Unnamed"}}{{/if}}</span>
          {{#if d.picksText}}<span class="cc-queue__picks">{{d.picksText}}</span>{{/if}}
        </div>
        <div class="cc-queue__state">
          <span class="cc-queue__badge cc-queue__badge--{{d.status}}">{{d.statusText}}</span>
          {{#if d.attemptText}}<span class="cc-queue__note">{{d.attemptText}}</span>{{/if}}
        </div>
        <div class="cc-queue__actions">
          <button type="button" class="cc-button" data-action="clear" data-user="{{d.userId}}" {{#if ../busy}}disabled{{/if}}>
            {{#if d.busy}}{{localize "CHARCREATOR.Pending.Clearing"}}{{else}}{{localize "CHARCREATOR.Pending.Clear"}}{{/if}}
          </button>
        </div>
      </li>
      {{else}}
      <li class="cc-empty">{{localize "CHARCREATOR.Pending.NoneInProgress"}}</li>
      {{/each}}
    </ul>
  </section>
  </div>
</div>
