{{!-- The GM's allowed content (PLAN 4.1): a tab per category, plus the packs and the ability-score methods. --}}
<div class="cc-restrict">
  <nav class="cc-restrict__tabs" role="tablist" aria-label="{{localize 'CHARCREATOR.Restrictions.Tabs'}}">
    {{#each tabs as |t|}}
    <button type="button" role="tab" id="cc-restrict-tab-{{t.key}}"
            class="cc-restrict__tab{{#if t.open}} cc-restrict__tab--open{{/if}}"
            data-action="show-tab" data-tab="{{t.key}}" aria-selected="{{t.open}}">
      <span class="cc-restrict__name">{{t.label}}</span>
      {{#if t.allowed}}<span class="cc-restrict__count">{{t.allowed}} / {{t.total}}</span>{{/if}}
      {{#if t.restricted}}<span class="cc-restrict__dot" aria-hidden="true"></span>{{/if}}
    </button>
    {{/each}}
  </nav>

  <section class="cc-restrict__pane">
    {{#if category}}
    <header class="cc-restrict__head">
      <div>
        <h2>{{localize (concat "CHARCREATOR.Restrictions.Tab." category.key)}}</h2>
        <p class="cc-hint">
          {{#if category.unrestricted}}{{localize "CHARCREATOR.Restrictions.AllAllowed"}}
          {{else}}{{localize "CHARCREATOR.Restrictions.SomeAllowed"}} {{category.allowed}} / {{category.total}}
          {{/if}}
        </p>
        {{#if category.duplicates}}
        <p class="cc-problem cc-problem--note cc-restrict__dupes">
          {{duplicateWarning}}
          <button type="button" class="cc-link" data-action="duplicates">
            {{#if category.onlyDuplicates}}{{localize "CHARCREATOR.Restrictions.ShowAll"}}
            {{else}}{{localize "CHARCREATOR.Restrictions.ShowDuplicates"}}{{/if}}
          </button>
        </p>
        {{/if}}
      </div>
      <div class="cc-restrict__tools">
        <label class="cc-search">
          <span class="cc-visually-hidden">{{localize "CHARCREATOR.Options.Search"}}</span>
          <input type="search" value="{{search}}" placeholder="{{localize 'CHARCREATOR.Options.Search'}}">
        </label>
        {{#if category.packs.length}}
        <label class="cc-pack-choice">
          <span class="cc-visually-hidden">{{localize "CHARCREATOR.Restrictions.FromPack"}}</span>
          <select class="cc-pack-filter cc-input cc-select">
            <option value="">{{localize "CHARCREATOR.Restrictions.AllPacks"}} ({{category.total}})</option>
            {{#each category.packs as |p|}}
            <option value="{{p.collection}}" {{#if p.selected}}selected{{/if}}>{{p.label}} ({{p.allowed}} / {{p.total}})</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        <button type="button" class="cc-button" data-action="allow-all" data-category="{{category.key}}">
          {{localize "CHARCREATOR.Restrictions.AllowAll"}}
        </button>
        <button type="button" class="cc-button" data-action="allow-none" data-category="{{category.key}}">
          {{localize "CHARCREATOR.Restrictions.AllowNone"}}
        </button>
        {{#if category.filtered}}
        <button type="button" class="cc-button" data-action="allow-these" data-category="{{category.key}}">
          {{localize "CHARCREATOR.Restrictions.AllowThese"}} ({{category.shown}})
        </button>
        <button type="button" class="cc-button" data-action="disallow-these" data-category="{{category.key}}">
          {{localize "CHARCREATOR.Restrictions.DisallowThese"}} ({{category.shown}})
        </button>
        {{/if}}
      </div>
    </header>

    <ul class="cc-list">
      {{#each category.entries as |e|}}
      <li class="cc-entry-row{{#if e.bothAllowed}} cc-entry-row--clash{{/if}}{{#if e.packOff}} cc-entry-row--off{{/if}}">
        <button type="button" class="cc-entry{{#if e.allowed}} cc-entry--allowed{{/if}}" data-action="entry"
                data-category="{{../category.key}}" data-uuid="{{e.uuid}}" aria-pressed="{{e.allowed}}"
                data-tooltip="{{e.tooltip}}" {{#if e.packOff}}disabled{{/if}}>
          {{#if e.img}}<img src="{{e.img}}" alt="">{{/if}}
          <span class="cc-entry__name">{{e.name}}</span>
          {{#if e.duplicate}}
          <span class="cc-entry__clash{{#unless e.bothAllowed}} cc-entry__clash--quiet{{/unless}}"
                data-tooltip="{{e.alsoInText}}" aria-label="{{e.alsoInText}}" role="img">
            <i class="fa-solid fa-triangle-exclamation" inert></i>
          </span>
          {{/if}}
          <span class="cc-entry__pack">{{#if e.packOff}}{{localize "CHARCREATOR.Restrictions.PackOff"}}{{else}}{{e.packLabel}}{{/if}}</span>
        </button>
        <button type="button" class="cc-entry__art{{#if e.art}} cc-entry__art--own{{/if}}" data-action="art"
                data-uuid="{{e.uuid}}" data-art="{{e.art}}"
                data-tooltip="{{e.artTooltip}}" aria-label="{{e.artTooltip}}">
          <i class="fa-solid fa-image" inert></i>
        </button>
        {{#if e.art}}
        <button type="button" class="cc-entry__art" data-action="art-clear" data-uuid="{{e.uuid}}"
                data-tooltip="{{localize 'CHARCREATOR.Restrictions.ArtClear'}}"
                aria-label="{{localize 'CHARCREATOR.Restrictions.ArtClear'}}">
          <i class="fa-solid fa-xmark" inert></i>
        </button>
        {{/if}}
      </li>
      {{/each}}
      {{#unless category.entries.length}}
      <li class="cc-empty">{{localize "CHARCREATOR.Restrictions.NothingHere"}}</li>
      {{/unless}}
    </ul>

    {{else if packs}}
    <header class="cc-restrict__head">
      <div>
        <h2>{{localize "CHARCREATOR.Restrictions.Tab.packs"}}</h2>
        <p class="cc-hint">{{localize "CHARCREATOR.Restrictions.PacksHint"}}</p>
      </div>
    </header>
    <ul class="cc-list">
      {{#each packs.entries as |p|}}
      <li>
        <button type="button" class="cc-entry{{#if p.allowed}} cc-entry--allowed{{/if}}" data-action="pack"
                data-pack="{{p.collection}}" aria-pressed="{{p.allowed}}">
          <span class="cc-entry__name">{{p.label}}</span>
          <span class="cc-entry__pack">{{p.collection}}</span>
        </button>
      </li>
      {{/each}}
    </ul>

    {{else if hardcore}}
    <header class="cc-restrict__head">
      <div>
        <h2>{{localize "CHARCREATOR.Restrictions.Tab.hardcore"}}</h2>
        <p class="cc-hint">{{localize "CHARCREATOR.Restrictions.HardcoreHint"}}</p>
      </div>
    </header>
    <div class="cc-switches">
      <button type="button" class="cc-switch cc-switch--main{{#if hardcore.offered}} cc-switch--on{{/if}}"
              data-action="hardcore" role="switch" aria-checked="{{hardcore.offered}}">
        <span class="cc-switch__track" aria-hidden="true"><span class="cc-switch__knob"></span></span>
        <span class="cc-switch__label">{{localize "CHARCREATOR.Restrictions.HardcoreOffered"}}</span>
      </button>
    </div>
    <p class="cc-hint cc-switches__lead">{{localize "CHARCREATOR.Restrictions.HardcoreParts"}}</p>
    {{!-- Off: the choices are kept and shown, but greyed until the mode is switched on again. --}}
    <div class="cc-switches cc-switches--grid{{#unless hardcore.offered}} cc-switches--off{{/unless}}">
      {{#each hardcore.parts as |p|}}
      <button type="button" class="cc-switch{{#unless p.free}} cc-switch--on{{/unless}}" data-action="random-part"
              data-part="{{p.part}}" role="switch" aria-checked="{{#unless p.free}}true{{else}}false{{/unless}}"
              {{#unless ../hardcore.offered}}disabled{{/unless}}>
        <span class="cc-switch__track" aria-hidden="true"><span class="cc-switch__knob"></span></span>
        <span class="cc-switch__label">{{p.label}}</span>
        <span class="cc-switch__state">
          {{#if p.free}}{{localize "CHARCREATOR.Restrictions.HardcoreFree"}}
          {{else}}{{localize "CHARCREATOR.Restrictions.HardcoreRolled"}}{{/if}}
        </span>
      </button>
      {{/each}}
    </div>

    {{else if backdrops}}
    <header class="cc-restrict__head">
      <div>
        <h2>{{localize "CHARCREATOR.Restrictions.Tab.backdrops"}}</h2>
        <p class="cc-hint">{{localize "CHARCREATOR.Restrictions.BackdropsHint"}}</p>
      </div>
    </header>
    <ul class="cc-list">
      {{#each backdrops as |b|}}
      <li class="cc-entry-row cc-backdrop-row" data-step="{{b.step}}">
        <div class="cc-entry cc-backdrop">
          <img class="cc-backdrop__img{{#unless b.own}} cc-backdrop__img--sigil{{/unless}}" src="{{b.img}}" alt="">
          <span class="cc-entry__name">{{b.label}}</span>
          <span class="cc-entry__pack">{{#if b.own}}{{b.own}}{{else}}{{localize "CHARCREATOR.Restrictions.BackdropDefault"}}{{/if}}</span>
        </div>
        <button type="button" class="cc-entry__art{{#if b.own}} cc-entry__art--own{{/if}}" data-action="step-art"
                data-step="{{b.step}}" data-art="{{b.own}}"
                data-tooltip="{{localize 'CHARCREATOR.Restrictions.ArtSet'}}" aria-label="{{localize 'CHARCREATOR.Restrictions.ArtSet'}}">
          <i class="fa-solid fa-image" inert></i>
        </button>
        {{#if b.own}}
        <button type="button" class="cc-entry__art" data-action="step-art-clear" data-step="{{b.step}}"
                data-tooltip="{{localize 'CHARCREATOR.Restrictions.BackdropClear'}}"
                aria-label="{{localize 'CHARCREATOR.Restrictions.BackdropClear'}}">
          <i class="fa-solid fa-xmark" inert></i>
        </button>
        {{/if}}
      </li>
      {{/each}}
    </ul>

    {{else}}
    <header class="cc-restrict__head">
      <div>
        <h2>{{localize "CHARCREATOR.Restrictions.Tab.abilities"}}</h2>
        <p class="cc-hint">{{localize "CHARCREATOR.Restrictions.AbilitiesHint"}}</p>
      </div>
    </header>
    <ul class="cc-list">
      {{#each methods as |m|}}
      <li>
        <button type="button" class="cc-entry{{#if m.allowed}} cc-entry--allowed{{/if}}" data-action="method"
                data-method="{{m.key}}" aria-pressed="{{m.allowed}}" {{#if m.only}}disabled{{/if}}>
          <span class="cc-entry__name">{{m.label}}</span>
          {{#if m.only}}<span class="cc-entry__pack">{{localize "CHARCREATOR.Restrictions.LastMethod"}}</span>{{/if}}
        </button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </section>

  <footer class="cc-restrict__footer">
    <ul class="cc-problems cc-restrict__warnings">
      {{#each warnings as |w|}}
      <li class="cc-problem cc-problem--{{w.level}}">{{w.message}}</li>
      {{/each}}
    </ul>
    <div class="cc-restrict__buttons">
      <button type="button" class="cc-button" data-action="cancel">{{localize "CHARCREATOR.Restrictions.Cancel"}}</button>
      <button type="button" class="cc-button cc-button--primary" data-action="save" {{#if saving}}disabled{{/if}}>
        {{localize "CHARCREATOR.Restrictions.Save"}}
      </button>
    </div>
  </footer>
</div>
