{{!-- Spells (PLAN 3.6; 8.4): cantrips, and each casting class's own shape — prepared, known, or a spellbook. --}}
<div class="cc-columns cc-columns--wide">
  <section class="cc-detail">
    <header class="cc-pane__header">
      <h1 class="cc-pane__title">{{stepTitle}}</h1>
      <p class="cc-pane__hint">{{stepHint}}</p>
    </header>

    {{#unless spells.caster}}
    <p class="cc-empty">{{localize "CHARCREATOR.Spells.NoSpells"}}</p>
    {{else}}
    {{#if spells.classes.length}}
    {{!-- A multiclassed caster (PLAN 8.4): each class chooses its own spells, tab by tab. --}}
    <p class="cc-asi-lead">{{localize "CHARCREATOR.Spells.EachClass" classes=spells.classesText}}</p>
    <div class="cc-methods cc-methods--classes" role="tablist" aria-label="{{localize 'CHARCREATOR.Spells.Classes'}}">
      {{#each spells.classes as |c|}}
      <button type="button" role="tab" class="cc-method{{#if c.open}} cc-method--selected{{/if}}" data-action="spell-class"
              data-root="{{c.root}}" aria-selected="{{c.open}}">
        {{#if c.complete}}<i class="fa-solid fa-check" inert></i> {{/if}}{{c.name}} {{c.chosen}} / {{c.needed}}
      </button>
      {{/each}}
    </div>
    {{#if spells.unfinishedText}}<p class="cc-hint">{{localize "CHARCREATOR.Spells.StillToChoose" classes=spells.unfinishedText}}</p>
    {{else}}<p class="cc-hint">{{localize "CHARCREATOR.Spells.AllClassesDone"}}</p>{{/if}}
    <h2 class="cc-section-title">{{localize "CHARCREATOR.Spells.ForClass" class=spells.className}}</h2>
    {{/if}}
    <div class="cc-methods" role="tablist" aria-label="{{localize 'CHARCREATOR.Spells.Lists'}}">
      {{#each spells.tabs as |t|}}
      <button type="button" role="tab" id="cc-spell-tab-{{t.key}}" class="cc-method{{#if t.open}} cc-method--selected{{/if}}" data-action="spell-tab"
              data-tab="{{t.key}}" aria-selected="{{t.open}}">
        {{localize (concat "CHARCREATOR.Spells." t.key)}} {{t.chosen}} / {{t.needed}}
      </button>
      {{/each}}
    </div>

    {{#with spells.open as |o|}}
    <p class="cc-hint">{{localize (concat "CHARCREATOR.Spells." o.key "Hint")}}</p>
    <div class="cc-cards cc-cards--spells">
      {{#each o.list as |s|}}
      <button type="button" class="cc-card cc-card--spell{{#if s.selected}} cc-card--selected{{/if}}" data-action="spell"
              data-uuid="{{s.uuid}}" data-kind="{{o.key}}" aria-pressed="{{s.selected}}" {{#if s.disabled}}disabled{{/if}}>
        {{#if s.img}}<img src="{{s.img}}" alt="">{{/if}}
        <span class="cc-card__text">
          <span class="cc-card__name">{{s.name}}</span>
          {{#if s.meta}}<span class="cc-card__meta">{{s.meta}}</span>{{/if}}
          {{#if s.hint}}<span class="cc-card__hint">{{s.hint}}</span>{{/if}}
        </span>
        {{#if s.already}}<span class="cc-card__warn">{{localize "CHARCREATOR.Spells.AlreadyKnown"}}</span>
        {{else if s.takenBy}}<span class="cc-card__warn">{{localize "CHARCREATOR.Spells.TakenBy" class=s.takenBy}}</span>{{/if}}
      </button>
      {{/each}}
      {{#unless o.list.length}}<p class="cc-empty">{{localize "CHARCREATOR.Spells.NothingToShow"}}</p>{{/unless}}
    </div>
    {{/with}}
    {{/unless}}
  </section>

  <aside class="cc-art cc-art--numbers">
    {{#if spells.caster}}
    <dl class="cc-facts">
      {{#each spells.tabs as |t|}}
      <div><dt>{{localize (concat "CHARCREATOR.Spells." t.key)}}</dt><dd>{{t.chosen}} / {{t.needed}}</dd></div>
      {{/each}}
    </dl>
    {{#if spells.known.length}}
    <div class="cc-known">
      <span class="cc-points__label">{{localize "CHARCREATOR.Spells.FromElsewhere"}}</span>
      <span>{{spells.knownText}}</span>
    </div>
    {{/if}}
    {{#if spells.errors.length}}
    <ul class="cc-problems">{{#each spells.errors as |e|}}<li class="cc-problem">{{e}}</li>{{/each}}</ul>
    {{/if}}
    {{/if}}
  </aside>
</div>
