{{!-- Start screen (PLAN 3.2): what this is, what the GM allows, and Begin / Resume. --}}
<div class="cc-start">
  <h1 class="cc-start__title">{{localize "CHARCREATOR.Start.Heading"}}</h1>
  <p class="cc-start__lead">{{localize "CHARCREATOR.Start.Lead"}}</p>
  <dl class="cc-facts">
    <div><dt>{{localize "CHARCREATOR.Start.Rules"}}</dt><dd>{{rulesLabel}}</dd></div>
    <div><dt>{{localize "CHARCREATOR.Step.species.Title"}}</dt><dd>{{summary.counts.species}}</dd></div>
    <div><dt>{{localize "CHARCREATOR.Step.class.Title"}}</dt><dd>{{summary.counts.class}}</dd></div>
    <div><dt>{{localize "CHARCREATOR.Step.background.Title"}}</dt><dd>{{summary.counts.background}}</dd></div>
  </dl>
  {{#if characters.show}}
  <p class="cc-start__limit{{#if characters.atLimit}} cc-problem{{/if}}">
    {{#if characters.atLimit}}{{localize "CHARCREATOR.Start.AtLimit"}}
    {{else}}{{localize "CHARCREATOR.Start.Allowance"}} {{characters.made}} / {{characters.limit}}
    {{/if}}
  </p>
  {{/if}}
  <div class="cc-start__ways">
    <button type="button" class="cc-button cc-button--primary cc-start__go" data-action="begin" {{#if busy}}disabled{{/if}}>
      {{#if resuming}}{{localize "CHARCREATOR.Start.Resume"}}{{else}}{{localize "CHARCREATOR.Start.Begin"}}{{/if}}
    </button>
    {{#if hardcore.offered}}
    {{!-- The dice make the whole character (D31). --}}
    <button type="button" class="cc-button cc-start__dice" data-action="roll-character" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-dice-d20" inert></i>
      {{#if busy}}{{localize "CHARCREATOR.Random.Rolling"}}{{else}}{{localize "CHARCREATOR.Random.Button"}}{{/if}}
    </button>
    {{/if}}
  </div>
  {{#if hardcore.offered}}<p class="cc-hint cc-start__dice-hint">{{localize "CHARCREATOR.Random.Hint"}}</p>{{/if}}
</div>
